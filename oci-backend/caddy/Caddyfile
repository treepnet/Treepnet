# Automatic HTTPS (Let's Encrypt). Custom subdomains are primary; the sslip.io
# hostnames are kept as a fallback. Each label gets its own cert (HTTP/TLS-ALPN
# on ports 80/443). Cloudflare/registrar DNS must point these at 130.61.138.104
# with proxy OFF (DNS only).

sync.treepnet.com, sync.130-61-138-104.sslip.io {
	reverse_proxy powersync:80
}

api.treepnet.com, rest.130-61-138-104.sslip.io {
	# Web "Delete account" backend (prefix stripped -> service sees /api/*).
	handle_path /delete-account/* {
		reverse_proxy deleteaccount:4000
	}
	# Auth (custom-token bridge; prefix stripped -> service sees /login etc.).
	handle_path /auth/* {
		reverse_proxy authservice:4100
	}
	# Crash/error logger (prefix stripped -> service sees /error). Forwards app
	# error reports to Treepnet's private Telegram bot.
	handle_path /log/* {
		reverse_proxy errorlogger:4200
	}
	reverse_proxy postgrest:3000
}

# Messenger chat backend — REST (/chat/dm/*) + Socket.IO (/socket.io, WebSocket
# upgrade handled automatically by reverse_proxy). Add the treepnet.com A-record
# for chat.treepnet.com; the sslip.io host works without DNS in the meantime.
chat.treepnet.com, chat.130-61-138-104.sslip.io {
	reverse_proxy chatbackend:3000
}

# Admin analytics dashboard (Metabase). Add the treepnet.com A-record for
# admin.treepnet.com (DNS only, proxy OFF) so Caddy can issue a cert; the sslip.io
# host works without DNS in the meantime. To restrict access, uncomment the IP
# allowlist and put your own IP in @admin.
admin.treepnet.com, admin.130-61-138-104.sslip.io {
	# @admin remote_ip 1.2.3.4/32
	# handle @admin {
	# 	reverse_proxy metabase:3000
	# }
	# respond 403
	reverse_proxy metabase:3000
}

# Referral invite landing + app-verification files (Android App Links now,
# iOS Universal Links later). The treepnet.com A-record must point at
# 130.61.138.104 (DNS only, proxy OFF) so Caddy can issue a cert. Static files
# live in ./caddy/web, mounted into the container at /srv/web.
treepnet.com, www.treepnet.com {
	root * /srv/web

	# Android App Links verification — must be application/json, 200, no redirect.
	handle /.well-known/assetlinks.json {
		header Content-Type application/json
		file_server
	}

	# iOS Universal Links verification — populated in the iOS phase; serving the
	# file early is harmless.
	handle /.well-known/apple-app-site-association {
		header Content-Type application/json
		file_server
	}

	# Invite links. When the app is installed the OS opens it directly and this
	# never runs; otherwise the page redirects (~0.1s) to the store, carrying the
	# invite handle as the Play install referrer.
	handle /invite/* {
		rewrite * /invite.html
		file_server
	}

	# Anything else -> the same smart page (a bare treepnet.com won't 404).
	handle {
		rewrite * /invite.html
		file_server
	}
}
