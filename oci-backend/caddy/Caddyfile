# Automatic HTTPS (Let's Encrypt). Custom subdomains are primary; the sslip.io
# hostnames are kept as a fallback. Each label gets its own cert (HTTP/TLS-ALPN
# on ports 80/443). Cloudflare/registrar DNS must point these at 130.61.138.104
# with proxy OFF (DNS only).

# Headers every public API answer carries: HTTPS only from now on (HSTS), no
# content-type guessing, no referrer leaks, no server banner.
(security_headers) {
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
		-Server
	}
}

# One access log for the API hosts (in the caddy_data volume): rotated at
# 20MiB, 10 files, 30 days. Request and response headers are left out, so
# tokens and keys never land in it.
(access_log) {
	log {
		output file /data/logs/access.log {
			roll_size 20MiB
			roll_keep 10
			roll_keep_for 720h
		}
		format filter {
			wrap json
			request>headers delete
			resp_headers delete
		}
	}
}

sync.treepnet.com, sync.130-61-138-104.sslip.io {
	import security_headers
	import access_log
	# The app only streams and checkpoints; sync bodies are small.
	request_body {
		max_size 2MB
	}
	# PowerSync's management API (token-protected) stays reachable inside the
	# server (127.0.0.1:8080) but not from the internet. Sync rules are
	# deployed from the config file, not through it.
	@powersync_admin path /api/admin /api/admin/* /api/sync-rules /api/sync-rules/*
	respond @powersync_admin 404
	reverse_proxy powersync:80
}

api.treepnet.com, rest.130-61-138-104.sslip.io {
	import security_headers
	import access_log
	# Rows, auth and crash reports — all small (media goes straight to object
	# storage, not through here).
	request_body {
		max_size 2MB
	}
	# Web "Delete account" backend (prefix stripped -> service sees /api/*).
	handle_path /delete-account/* {
		reverse_proxy deleteaccount:4000
	}
	# Auth (custom-token bridge; prefix stripped -> service sees /login etc.).
	handle_path /auth/* {
		reverse_proxy authservice:4100
	}
	# Crash/error logger (prefix stripped -> service sees /error). Forwards app
	# error reports to Treepnet's private Telegram bot.
	handle_path /log/* {
		reverse_proxy errorlogger:4200
	}
	# App update gate (lib/app/view/app_update_gate.dart): per-platform minBuild /
	# latestBuild / storeUrl. Static JSON in ./caddy/web/app-config (mounted at
	# /srv/web); edit the file to change it — no reload needed. Raise minBuild
	# only after that build is 100% live on the store; lower it to undo a block.
	handle_path /app-config/* {
		root * /srv/web/app-config
		header Cache-Control "no-cache"
		file_server
	}
	reverse_proxy postgrest:3000
}

# Messenger chat backend — REST (/chat/dm/*) + Socket.IO (/socket.io, WebSocket
# upgrade handled automatically by reverse_proxy). Add the treepnet.com A-record
# for chat.treepnet.com; the sslip.io host works without DNS in the meantime.
chat.treepnet.com, chat.130-61-138-104.sslip.io {
	import security_headers
	import access_log
	# Text only: the chat has no uploads any more, and the backend takes JSON
	# bodies up to 1MB (a message is at most 8000 characters).
	request_body {
		max_size 1MB
	}
	reverse_proxy chatbackend:3000
}

# Custom admin analytics panel. Static SPA built from the Treepnet-admin-panel
# repo (served from ./caddy/admin -> /srv/admin), plus the read-only analytics
# API at /api/* -> analyticsapi:4300. basic_auth gates BOTH the page and the API
# (same origin, so the browser replays the credentials to /api automatically).
# The hash lives only in the server .env ({$ADMIN_BASIC_HASH}). Add the
# admin.treepnet.com A-record at 130.61.138.104 (DNS only, proxy OFF); the
# sslip.io host works without DNS in the meantime.
admin.treepnet.com, admin.130-61-138-104.sslip.io {
	basic_auth {
		admin {$ADMIN_BASIC_HASH}
	}

	handle_path /api/* {
		reverse_proxy analyticsapi:4300
	}

	# Static SPA for everything else. Wrapped in its own handle so the try_files
	# rewrite below never touches /api/* (which handle_path has already taken).
	handle {
		root * /srv/admin
		try_files {path} /index.html
		file_server
	}
}

# treepnet.com / www (invite links, App Links files) are served by Cloudflare
# (treepnet-web), not here: the block that was here only failed to get a
# certificate. ./caddy/web stays — app-config is served from it above.
