# Copy to `.env` and fill in real values. `.env` is gitignored — never commit it.
# docker-compose substitutes ${VAR} from this file.

# --- Postgres (app database) ---
POSTGRES_USER=treepadmin
POSTGRES_DB=treepnet
POSTGRES_PASSWORD=change-me-strong-password

# --- PowerSync logical-replication role (created by postgres/initdb/01-powersync.sh) ---
POWERSYNC_PG_USER=powersync
POWERSYNC_PG_PASSWORD=change-me-strong-password

# --- PostgREST authenticator role ---
AUTHENTICATOR_PASSWORD=change-me-strong-password

# --- PowerSync admin API token (any long random string) ---
POWERSYNC_ADMIN_TOKEN=change-me-long-random-string

# --- delete-account SMTP (Gmail app password) ---
SMTP_PASS=change-me-gmail-app-password

# --- Crash/error logger -> Telegram (error-logger service) ---
# Bot token + chat id for Treepnet's private crash-log bot. Kept server-side
# only; never shipped in the app. LOG_APP_KEY must match the constant compiled
# into the app (lib/monitoring/crash_reporter.dart).
TG_LOG_BOT_TOKEN=change-me-telegram-bot-token
TG_LOG_CHAT_ID=change-me-telegram-chat-id
LOG_APP_KEY=treepnet-log-2026

# --- Admin analytics (Metabase) ---
# metabase_app: owns the separate `metabase` config database.
# analytics_ro: read-only role Metabase uses to query the app DB (analytics views).
# Both roles are created manually; these are their passwords (never in git).
METABASE_DB_PASS=change-me-strong-password
ANALYTICS_RO_PASS=change-me-strong-password

# --- Reserved / optional (not required by the current docker-compose) ---
# POSTGREST_JWT_SECRET=     # PostgREST reads Entra JWKS from postgrest/jwks.json instead
# POWERSYNC_JWKS_SECRET=    # PowerSync validates client tokens via PS_JWKS_URL (Entra)
