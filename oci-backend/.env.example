# Copy to `.env` and fill in real values. `.env` is gitignored — never commit it.
# docker-compose substitutes ${VAR} from this file.

# --- Postgres (app database) ---
POSTGRES_USER=treepadmin
POSTGRES_DB=treepnet
POSTGRES_PASSWORD=change-me-strong-password

# --- PowerSync logical-replication role (created by postgres/initdb/01-powersync.sh) ---
POWERSYNC_PG_USER=powersync
POWERSYNC_PG_PASSWORD=change-me-strong-password

# --- PostgREST authenticator role ---
AUTHENTICATOR_PASSWORD=change-me-strong-password

# --- PowerSync admin API token (any long random string) ---
POWERSYNC_ADMIN_TOKEN=change-me-long-random-string

# --- delete-account SMTP (Gmail app password) ---
SMTP_PASS=change-me-gmail-app-password

# --- Reserved / optional (not required by the current docker-compose) ---
# POSTGREST_JWT_SECRET=     # PostgREST reads Entra JWKS from postgrest/jwks.json instead
# POWERSYNC_JWKS_SECRET=    # PowerSync validates client tokens via PS_JWKS_URL (Entra)
