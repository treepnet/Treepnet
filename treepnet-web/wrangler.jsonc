{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "treepnet-web",
  "main": "worker.js",
  "compatibility_date": "2026-09-08",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/invite/*", "/.well-known/apple-app-site-association"]
  }
}
